[Unit]
Description=Delete expired temporary food photos

[Service]
Type=oneshot
User=food-media
Group=food-media
EnvironmentFile=/etc/food-checking-media.env
ExecStart=/usr/bin/python3 /opt/food-checking-media/server.py --cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/food-checking-media
