[Unit]
Description=Food mobile reverse tunnel to Russian server
After=network-online.target
Wants=network-online.target

[Service]
User=solovyshka
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -R 127.0.0.1:18092:192.168.100.41:8092 root@135.106.218.22
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
