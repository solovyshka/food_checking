[Unit]
Description=Food Checking Inventory Telegram Bot
After=network.target postgresql.service ovh-telegram-proxy.service
Wants=ovh-telegram-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/food_checking
EnvironmentFile=/opt/food_checking/.env
ExecStart=/opt/food_checking/venv/bin/python -m app.bot.inventory
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
