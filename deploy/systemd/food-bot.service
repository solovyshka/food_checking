[Unit]
Description=Food Checking Telegram Bot
After=network.target postgresql.service food-whisper.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/food_checking
EnvironmentFile=/opt/food_checking/.env
ExecStart=/opt/food_checking/venv/bin/python -m app.bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
