[Unit]
Description=Food Checking Whisper STT
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/food_checking
EnvironmentFile=/opt/food_checking/.env
ExecStart=/opt/food_checking/whisper-venv/bin/python /opt/food_checking/whisper/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
