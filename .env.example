TELEGRAM_BOT_TOKEN=
# Бот потребления калорий («съел») — отдельный процесс food-eat-bot
TELEGRAM_CONSUMPTION_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789
DATABASE_URL=postgresql://food:changeme@127.0.0.1:5432/food_checking
WHISPER_URL=http://127.0.0.1:9000
WHISPER_MODEL=small
WHISPER_HOST=127.0.0.1
WHISPER_PORT=9000
QWEN_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5:7b-instruct-q4_K_M
# -1 keep model loaded; 0 unload after request. Must be a number or duration with unit (5m).
OLLAMA_KEEP_ALIVE=-1
# Direct OpenAI — трафик через HideMyName split-VPN (только на сервере)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PARSE_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=gpt-transcribe
OPENAI_HTTP_REFERER=https://github.com/solovyshka/food_checking
OPENAI_APP_TITLE=food_checking
GIGAAM_ENABLED=1
GIGAAM_URL=http://127.0.0.1:9001
GIGAAM_MODEL=v3_e2e_ctc
GIGAAM_KEEP_ALIVE=1
GIGAAM_CACHE=/hdd/disk_1/models/gigaam
# gigaam | whisper — что идёт в Ollama после голоса
VOICE_STT_BACKEND=gigaam
HIDEME_VPN_ENABLED=1
HIDEME_VPN_SCRIPT=/opt/food_checking/deploy/vpn/hideme-openai.sh
HIDEME_OVPN_CONF=/opt/secrets/food_checking/vpn/netherlands-split.ovpn
TZ=Europe/Moscow
APP_HOST=127.0.0.1
APP_PORT=8088
# Публичный URL статических HTML-таблиц (nginx /r/<token>.html)
PUBLIC_BASE_URL=http://161.104.53.72
REPORTS_DIR=/opt/food_checking/var/reports
# Google Sheets (наличие): см. docs/google-sheets.md
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/secrets/food_checking/google-sa.json
GOOGLE_SHEETS_TAB_CURRENT=Текущее
GOOGLE_SHEETS_TAB_PROPOSAL=Предложение
